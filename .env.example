# Supabase
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.yourproject.supabase.co:5432/postgres

# Gravity Forms sites. ck/cs are the WP REST API consumer key and secret.
# automation_forms is the list of form ids the automation created.
# start_date is the cutoff, entries before it get skipped.
GF_SITES_JSON=[{"key": "example site", "site": "https://example.com", "ck": "ck_xxxx", "cs": "cs_xxxx", "automation_forms": [1, 2], "start_date": "2025-01-01"}]

# Same shape as above but for every site, with a flag for whether it has automation
ALL_GF_NON_AUTOMATION_SITES=[{"key": "example site", "site": "https://example.com", "ck": "ck_xxxx", "cs": "cs_xxxx", "automation": false}]

# CallTrackingMetrics
CTM_SITES=[{"key": "example site", "site": "https://example.com", "id": "123456", "tracking_number": "5551234567"}]
ACCESS_KEY=your-ctm-access-key
SECRET_KEY=your-ctm-secret-key

# Google OAuth for the Search Console API
CLIENT_ID=your-google-client-id
CLIENT_SECRET=your-google-client-secret
REFRESH_TOKEN=your-google-refresh-token

# Search Console properties to pull. Use sc-domain: prefix for domain properties.
GSC_SITES_JSON=[{"key": "example site", "site": "https://example.com", "gsc_property": "https://example.com"}]

# Regex that matches the URLs of pages created by the automation
AUTOMATION_PAGE_REGEX=/(service-one|service-two)-[a-z-]+/$
